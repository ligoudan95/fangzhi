[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/view/battle_view.gd" id="1_battleview"]

[node name="BattleView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_battleview")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.09, 0.08, 0.07, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 48

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "莽荒兽契 · 战斗演出"
horizontal_alignment = 1

[node name="Toolbar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StageOption" type="OptionButton" parent="Margin/VBox/Toolbar"]
layout_mode = 2
size_flags_horizontal = 3
item_count = 0

[node name="SpeedButton" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
custom_minimum_size = Vector2(96, 0)
text = "1x"

[node name="SkipButton" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "跳过"

[node name="ReplayButton" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "重播"

[node name="NewBattleButton" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "新战斗"

[node name="LogScroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="LogText" type="RichTextLabel" parent="Margin/VBox/LogScroll"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = false
scroll_following = true
theme_override_font_sizes/normal_font_size = 22

[node name="Result" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1

[connection signal="pressed" from="Margin/VBox/Toolbar/SpeedButton" to="." method="_on_speed_pressed"]
[connection signal="pressed" from="Margin/VBox/Toolbar/SkipButton" to="." method="_on_skip_pressed"]
[connection signal="pressed" from="Margin/VBox/Toolbar/ReplayButton" to="." method="_on_replay_pressed"]
[connection signal="pressed" from="Margin/VBox/Toolbar/NewBattleButton" to="." method="_on_new_battle_pressed"]
